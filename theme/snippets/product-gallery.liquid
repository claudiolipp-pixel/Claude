{% doc %}
  The product slideshow.

  A court that packs into a backpack is not a thing anyone has seen before, so
  the gallery is the sales argument: what you get as a whole, then each part on
  its own so it can be counted, then the thing in a real game. Someone about to
  spend three hundred euro wants to check that the pump is really included.

  The order is Shopify's media order, so rearranging it in the admin is what
  decides which frame a buyer sees first.

  Every frame stays in the DOM and only opacity changes. Swapping the src would
  show an empty frame on a slow connection, which is exactly when a buyer is
  least patient.

  @param {object} product - The product whose media to show.

  @example
  {% render 'product-gallery', product: product %}
{% enddoc %}

{%- liquid
  assign media = product.media | where: 'media_type', 'image'
  assign total = media.size
-%}

<product-gallery class="gallery" data-total="{{ total }}">
  <div
    class="frame gallery__frame"
    tabindex="0"
    role="group"
    aria-roledescription="carousel"
    aria-label="{{ product.title | escape }}"
  >
    {%- for item in media -%}
      <img
        class="gallery__image{% if forloop.first %} is-current{% endif %}"
        src="{{ item | image_url: width: 900 }}"
        srcset="
          {{ item | image_url: width: 600 }} 600w,
          {{ item | image_url: width: 900 }} 900w,
          {{ item | image_url: width: 1200 }} 1200w
        "
        sizes="(min-width: 900px) 46vw, 100vw"
        alt="{{ item.alt | default: product.title | escape }}"
        width="{{ item.width }}"
        height="{{ item.height }}"
        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
        data-index="{{ forloop.index0 }}"
        {% unless forloop.first %}aria-hidden="true"{% endunless %}
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'gallery__placeholder' }}
    {%- endfor -%}

    {%- if total > 1 -%}
      <button type="button" class="gallery__arrow gallery__arrow--prev label" data-gallery-prev aria-label="{{ 'products.gallery.previous' | t }}">
        <span aria-hidden="true">&#8592;</span>
      </button>
      <button type="button" class="gallery__arrow gallery__arrow--next label" data-gallery-next aria-label="{{ 'products.gallery.next' | t }}">
        <span aria-hidden="true">&#8594;</span>
      </button>
      <span class="gallery__counter label tabular" aria-hidden="true">
        <span data-gallery-current>01</span> / {{ total | prepend: '0' | slice: -2, 2 }}
      </span>
    {%- endif -%}
  </div>

  {%- if total > 1 -%}
    {%- comment -%}
      Thumbnails, so the number of parts is visible without clicking through
      the whole strip.
    {%- endcomment -%}
    <div class="gallery__thumbs">
      {%- for item in media -%}
        <button
          type="button"
          class="gallery__thumb{% if forloop.first %} is-current{% endif %}"
          data-gallery-go="{{ forloop.index0 }}"
          aria-label="{{ 'products.gallery.label' | t: n: forloop.index, total: total }}"
          {% if forloop.first %}aria-current="true"{% endif %}
        >
          <img src="{{ item | image_url: width: 160 }}" alt="" width="160" height="200" loading="lazy">
        </button>
      {%- endfor -%}
    </div>

    {%- comment -%}
      Announced to screen readers when the frame changes, since the visual
      counter tells them nothing.
    {%- endcomment -%}
    <p class="visually-hidden" aria-live="polite" data-gallery-status></p>
  {%- endif -%}
</product-gallery>

{% stylesheet %}
  .gallery {
    display: block;
  }

  .gallery__frame:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .gallery__image {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 500ms var(--ease);
  }
  .gallery__image.is-current {
    opacity: 1;
  }

  .gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(242, 239, 231, 0.9);
    color: var(--color-court);
    border: 0;
    padding: 16px 12px;
    cursor: pointer;
    transition: background-color 200ms var(--ease);
  }
  .gallery__arrow:hover,
  .gallery__arrow:focus-visible {
    background: var(--color-butter);
  }
  .gallery__arrow--prev { left: 12px; }
  .gallery__arrow--next { right: 12px; }

  .gallery__counter {
    position: absolute;
    right: 12px;
    bottom: 12px;
    background: rgba(10, 10, 10, 0.75);
    color: var(--color-chalk);
    padding: 6px 10px;
  }

  .gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .gallery__thumb {
    width: 64px;
    height: 80px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-court);
    opacity: 0.55;
    cursor: pointer;
    transition: opacity 200ms var(--ease);
  }
  .gallery__thumb:hover {
    opacity: 1;
  }
  .gallery__thumb.is-current {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--color-ground), 0 0 0 4px var(--color-ink);
  }
  .gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .gallery__thumb {
      width: 70px;
      height: 88px;
    }
  }
{% endstylesheet %}

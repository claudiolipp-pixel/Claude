{%- comment -%}
  Not found. Short, and it offers the one thing that helps: the way back to
  the products.
{%- endcomment -%}

<div class="not-found page">
  <h1 class="not-found__title">{{ 'general.not_found.title' | t }}</h1>
  <p class="not-found__body">{{ 'general.not_found.body' | t }}</p>
  <a class="button button--secondary not-found__cta" href="{{ routes.root_url }}">
    {{ 'cart.empty_cta' | t }}
  </a>
</div>

{% stylesheet %}
  .not-found {
    padding-block: 80px 120px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .not-found__title { font-size: var(--text-h2); }
  .not-found__body { color: var(--color-ink-soft); max-width: 44ch; }
  .not-found__cta { width: auto; }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main_404.name", "tag": "section" }
{% endschema %}

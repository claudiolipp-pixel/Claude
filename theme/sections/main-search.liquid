{%- comment -%}
  Search exists because Shopify requires the template, not because a shop with
  three products needs it. Kept to a working minimum on purpose: a form, the
  results, nothing else.
{%- endcomment -%}

<div class="search page">
  <h1 class="search__title">{{ 'general.search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
    <label class="visually-hidden" for="search-field">{{ 'general.search.title' | t }}</label>
    <input
      id="search-field"
      class="search__input"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.placeholder' | t }}"
    >
    <button type="submit" class="button button--secondary search__submit">
      {{ 'general.search.submit' | t }}
    </button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <div class="search__results">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="search__empty">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</div>

{% stylesheet %}
  .search { padding-block: 40px 80px; }
  .search__title { font-size: var(--text-h2); }
  .search__form { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .search__input {
    flex: 1 1 240px;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--color-ink);
    padding: 12px 14px;
  }
  .search__submit { width: auto; }
  .search__results { display: grid; gap: 24px; margin-top: 40px; }
  @media (min-width: 768px) {
    .search__results { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .search__empty { margin-top: 32px; color: var(--color-ink-soft); }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main_search.name", "tag": "section" }
{% endschema %}

{%- comment -%}
  A collection listing, in the same grid as the index. Reached mainly by
  Shopify's own links; the shop's front door is the index.
{%- endcomment -%}

<div class="collection page">
  <h1 class="collection__title">{{ collection.title }}</h1>

  {%- if collection.description != blank -%}
    <div class="collection__body rte">{{ collection.description }}</div>
  {%- endif -%}

  {%- paginate collection.products by 24 -%}
    <div class="collection__items">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="collection__pages label" aria-label="{{ 'general.pagination' | t }}">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}">{{ paginate.previous.title }}</a>
        {%- endif -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}">{{ paginate.next.title }}</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .collection { padding-block: 40px 80px; }
  .collection__title { font-size: var(--text-h2); }
  .collection__body { margin-top: 16px; max-width: 60ch; color: var(--color-ink-soft); }
  .collection__items { display: grid; gap: 24px; margin-top: 36px; }
  @media (min-width: 768px) {
    .collection__items { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .collection__pages { display: flex; gap: 16px; margin-top: 40px; }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main_collection.name", "tag": "section" }
{% endschema %}

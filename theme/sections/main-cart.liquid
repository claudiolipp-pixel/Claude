{%- comment -%}
  The cart page.

  Almost nobody reaches it: the drawer handles the cart, and the checkout
  button posts straight from there. This page is what happens when JavaScript
  does not run, when a form falls back, or when someone bookmarks /cart. It has
  to work completely on its own, with no script at all.
{%- endcomment -%}

<div class="cart-page page">
  <h1 class="cart-page__title">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <p class="cart-page__empty">{{ 'cart.empty' | t }}</p>
    <a class="button button--secondary cart-page__cta" href="{{ routes.root_url }}">{{ 'cart.empty_cta' | t }}</a>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <ul class="cart-page__lines">
        {%- for item in cart.items -%}
          <li class="cart-line">
            <a class="cart-line__media" href="{{ item.url }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="" width="80" height="100" loading="lazy">
              {%- endif -%}
            </a>

            <div class="cart-line__body">
              <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
              <span class="cart-line__price tabular">{{ item.final_line_price | money }}</span>
            </div>

            <label class="visually-hidden" for="updates_{{ item.key }}">{{ 'products.quantity.label' | t }}</label>
            <input
              id="updates_{{ item.key }}"
              class="cart-line__quantity tabular"
              type="number"
              name="updates[]"
              value="{{ item.quantity }}"
              min="0"
              inputmode="numeric"
            >
          </li>
        {%- endfor -%}
      </ul>

      <div class="cart-page__foot">
        <div class="cart-page__sum">
          <span class="label">{{ 'cart.subtotal' | t }}</span>
          <span class="cart-page__total tabular">{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-page__note">{{ 'cart.note' | t }}</p>
        <div class="cart-page__buttons">
          <button type="submit" name="update" class="button button--secondary">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="button button--primary">{{ 'cart.checkout' | t }}</button>
        </div>
      </div>
    </form>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-page { padding-block: 40px 96px; max-width: 760px; }
  .cart-page__title { font-size: var(--text-h2); }
  .cart-page__empty { margin-top: 20px; color: var(--color-ink-soft); }
  .cart-page__cta { width: auto; margin-top: 20px; }

  .cart-page__lines { list-style: none; margin: 32px 0 0; padding: 0; border-top: 1px solid var(--color-rule); }

  .cart-line {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-rule-soft);
  }
  .cart-line__media img { width: 80px; height: 100px; object-fit: cover; border-radius: 6px; background: var(--color-court); }
  .cart-line__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .cart-line__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 20px;
    text-decoration: none;
  }
  .cart-line__price { color: var(--color-ink-soft); }
  .cart-line__quantity {
    width: 64px;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--color-ink);
    padding: 8px;
    text-align: center;
  }

  .cart-page__foot { margin-top: 32px; }
  .cart-page__sum { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .cart-page__total { font-family: var(--font-display); font-weight: 900; font-size: 30px; }
  .cart-page__note { margin-top: 6px; font-size: 12px; color: var(--color-ink-mute); }
  .cart-page__buttons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .cart-page__buttons .button { flex: 1 1 200px; width: auto; }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main_cart.name", "tag": "section" }
{% endschema %}

{%- comment -%}
  THE CART, AS A PANEL THAT SLIDES IN FROM THE RIGHT.

  A section rather than a snippet on purpose: that makes it addressable by the
  Section Rendering API, so after every change the markup is re-rendered by
  Liquid instead of rebuilt in JavaScript. One template for the cart, not two
  that drift.

  A drawer rather than a page because adding something should not cost the
  visitor the product they were reading. It opens over the page, and the page
  keeps its scroll position and its place in the gallery.

  Shipping is deliberately not estimated here. Shopify computes it from the
  address, and a number invented on this side that the next screen contradicts
  is worse than no number.
{%- endcomment -%}

<cart-drawer class="drawer">
  <button type="button" class="drawer__scrim" data-cart-scrim tabindex="-1" aria-hidden="true"></button>

  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
    <header class="drawer__head">
      <h2 class="drawer__title">
        {{ 'cart.title' | t }}
        {%- if cart.item_count > 0 -%}
          <span class="drawer__count tabular">{{ cart.item_count }}</span>
        {%- endif -%}
      </h2>
      <button type="button" class="drawer__close" data-cart-close aria-label="{{ 'cart.close' | t }}">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </button>
    </header>

    {%- if cart.item_count == 0 -%}
      <div class="drawer__empty">
        <p>{{ 'cart.empty' | t }}</p>
        <a class="button button--secondary drawer__empty-cta" href="{{ routes.root_url }}">
          {{ 'cart.empty_cta' | t }}
        </a>
      </div>
    {%- else -%}
      <ul class="drawer__lines">
        {%- for item in cart.items -%}
          <li class="line">
            <a class="line__media" href="{{ item.url }}">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 200 }}" alt="" width="70" height="88" loading="lazy">
              {%- endif -%}
            </a>

            <div class="line__body">
              <div class="line__top">
                <a class="line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                <span class="line__total tabular">{{ item.final_line_price | money }}</span>
              </div>

              {%- comment -%}
                The line total is what people check, so the unit price is only
                worth showing once it differs from it.
              {%- endcomment -%}
              {%- if item.quantity > 1 -%}
                <p class="line__unit tabular">{{ item.final_price | money }}</p>
              {%- endif -%}

              <div class="line__actions">
                <div class="line__stepper label">
                  <button
                    type="button"
                    class="line__step"
                    data-cart-step="{{ item.quantity | minus: 1 }}"
                    data-line="{{ forloop.index }}"
                    aria-label="{{ 'products.quantity.decrease' | t }}"
                  >
                    &minus;
                  </button>
                  <span class="line__quantity tabular">{{ item.quantity }}</span>
                  <button
                    type="button"
                    class="line__step"
                    data-cart-step="{{ item.quantity | plus: 1 }}"
                    data-line="{{ forloop.index }}"
                    aria-label="{{ 'products.quantity.increase' | t }}"
                  >
                    +
                  </button>
                </div>

                <button type="button" class="line__remove label" data-cart-remove="{{ forloop.index }}">
                  {{ 'cart.remove' | t }}
                </button>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      <div class="drawer__foot">
        <div class="drawer__sum">
          <span class="label drawer__sum-label">{{ 'cart.subtotal' | t }}</span>
          <span class="drawer__sum-value tabular">{{ cart.total_price | money }}</span>
        </div>
        <p class="drawer__note">{{ 'cart.note' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="button button--primary">
            {{ 'cart.checkout' | t }}
          </button>
        </form>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% stylesheet %}
  /* Closed is the default, so the panel is inert until it is opened. A drawer
     that renders open for a moment on every page load is worse than one that
     animates a beat late. */
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: none;
  }
  .drawer[open] {
    display: block;
  }

  .drawer__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background: rgba(10, 10, 10, 0.5);
    cursor: default;
    animation: drawer-fade 240ms ease-out;
  }

  .drawer__panel {
    position: absolute;
    inset-block: 0;
    right: 0;
    width: 100%;
    max-width: 430px;
    display: flex;
    flex-direction: column;
    background: var(--color-ground);
    box-shadow: 0 0 60px rgba(10, 10, 10, 0.25);
    animation: drawer-in 300ms var(--ease);
  }

  @keyframes drawer-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes drawer-in {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px;
    border-bottom: 1px solid var(--color-rule);
  }
  @media (min-width: 768px) {
    .drawer__head { padding-inline: 24px; }
  }

  .drawer__title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 26px;
  }
  .drawer__count {
    border-radius: 999px;
    background: var(--color-court);
    color: var(--color-cream);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    padding: 4px 8px;
  }

  .drawer__close {
    background: transparent;
    border: 0;
    padding: 8px;
    margin-right: -8px;
    color: var(--color-ink-mute);
    cursor: pointer;
    transition: color 200ms var(--ease);
  }
  .drawer__close:hover {
    color: var(--color-ink);
  }

  .drawer__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 24px;
    text-align: center;
    color: var(--color-ink-soft);
  }
  .drawer__empty-cta { width: auto; }

  .drawer__lines {
    flex: 1;
    overflow-y: auto;
    list-style: none;
    margin: 0;
    padding: 20px;
  }
  @media (min-width: 768px) {
    .drawer__lines { padding-inline: 24px; }
  }

  .line {
    display: flex;
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-rule-soft);
  }
  .line:first-child { padding-top: 0; }
  .line:last-child { border-bottom: 0; }

  .line__media {
    flex: 0 0 auto;
  }
  .line__media img {
    width: 70px;
    height: 88px;
    object-fit: cover;
    border-radius: 6px;
    background: var(--color-court);
  }

  .line__body {
    flex: 1;
    min-width: 0;
  }

  .line__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .line__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: 19px;
    line-height: 1.05;
    text-decoration: none;
  }
  .line__title:hover {
    background: var(--color-butter);
  }

  .line__unit {
    margin-top: 2px;
    font-size: 13px;
    color: var(--color-ink-mute);
  }

  .line__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
  }

  .line__stepper {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-rule);
  }
  .line__step {
    background: transparent;
    border: 0;
    padding: 8px 12px;
    cursor: pointer;
    transition: background-color 200ms var(--ease);
  }
  .line__step:hover {
    background: var(--color-butter);
  }
  .line__quantity {
    min-width: 2ch;
    text-align: center;
  }

  .line__remove {
    background: transparent;
    border: 0;
    padding: 0;
    font-size: 11px;
    color: var(--color-ink-mute);
    cursor: pointer;
    text-underline-offset: 4px;
    transition: color 200ms var(--ease);
  }
  .line__remove:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }

  .drawer__foot {
    border-top: 1px solid var(--color-rule);
    padding: 20px 20px 24px;
  }
  @media (min-width: 768px) {
    .drawer__foot { padding-inline: 24px; }
  }

  .drawer__sum {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .drawer__sum-label { color: var(--color-ink-mute); }
  .drawer__sum-value {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 26px;
  }

  .drawer__note {
    margin-top: 6px;
    font-size: 12px;
    color: var(--color-ink-mute);
  }

  .drawer__foot form {
    margin: 16px 0 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "tag": "div"
}
{% endschema %}

# Loaded automatically by `vite build`, including on Cloudflare's CI, so no
# dashboard build variable is needed.
#
# Deliberately NOT loaded in dev: `npm run dev` leaves this unset, so testing
# the form locally logs to the console instead of writing junk rows into the
# live Sheet.
VITE_WAITLIST_ENDPOINT=https://script.google.com/macros/s/AKfycbz4AeDZcG1fTDgINxb3s1vcloGo-NZ7d8HopDb1f_kOAgIO2f33nJcguBaBtk7Qmmmm/exec

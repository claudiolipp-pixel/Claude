# Response headers for the Cloudflare Worker's static assets.
#
# Cloudflare reads this file at deploy time; it is not served to visitors.
# Syntax: a path pattern on its own line, then indented "Name: value" pairs.
#
# What this file cannot do: redirect plain HTTP to HTTPS. That request never
# reaches the assets, so it has to be the zone setting
# SSL/TLS -> Edge Certificates -> Always Use HTTPS. HSTS below only takes
# effect once a visitor has been served over HTTPS at least once, which is
# exactly why that setting is still needed.

/*
  # Tell browsers to refuse plain HTTP for a year. includeSubDomains covers
  # anything under airball.at, so every subdomain must be able to serve HTTPS
  # before this is deployed. "preload" is deliberately not set: it is a
  # separate, hard-to-undo submission to the browser preload list.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # No framing at all, so the site cannot be loaded into an attacker's page and
  # clicked through invisibly. X-Frame-Options is the old spelling of the same
  # thing, kept for browsers that predate frame-ancestors.
  X-Frame-Options: DENY

  # Stop browsers from guessing a type other than the one we send. Without it,
  # something uploaded as an image can be talked into executing as script.
  X-Content-Type-Options: nosniff

  # Send the full URL only within our own origin; other sites see the origin.
  Referrer-Policy: strict-origin-when-cross-origin

  # The site asks for none of these, so no embedded frame can either.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # Content Security Policy.
  #
  # script-src is 'self' with no 'unsafe-inline': the build emits no inline
  # script, so anything injected into the HTML will not run.
  #
  # style-src needs 'unsafe-inline' and cannot avoid it. GSAP animates by
  # writing to element.style on every frame, and inline style attributes are
  # governed by style-src. Removing it would stop the animation dead.
  #
  # connect-src allows the waitlist endpoint. Apps Script answers a POST with a
  # redirect to script.googleusercontent.com, so both hosts are needed.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Hashed filenames never change contents, so they can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
